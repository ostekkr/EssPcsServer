<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="EssPcsServer.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <appSettings>
    <add key="C1ApplicationTheme" value="VS2013Light" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <add key="C1ApplicationThemeSettings" />
  </appSettings>
  <userSettings>
    <EssPcsServer.Properties.Settings>
      <setting name="sitePort1" serializeAs="String">
        <value>58002</value>
      </setting>
      <setting name="trayMove" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="saveData" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="hmiMode" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="siteUrl1" serializeAs="String">
        <value>http://amikr.dyndns.org</value>
      </setting>
      <setting name="runSQLite" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="sitePort2" serializeAs="String">
        <value>58002</value>
      </setting>
      <setting name="siteUrl2" serializeAs="String">
        <value>http://192.168.10.251</value>
      </setting>
      <setting name="pcsOutputP" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="essChargeStartHour" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="essChargeStartMin" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="essChargeEndHour" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="essChargeEndMin" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="essChargeSocLimit" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="essChargeOutputLimit" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="essDischargeStartHour" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="essDischargeStartMin" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="essDischargeEndHour" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="essDischargeEndMin" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="essDischargeSocLimit" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="essDischargeOutputLimit" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="essGenUse" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="essGenOutPower" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="essGenOutPercent" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="essControlPeriod" serializeAs="String">
        <value>1</value>
      </setting>
      <setting name="pcsOutputQ" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="rtuIp1" serializeAs="String">
        <value>192.168.1.101</value>
      </setting>
      <setting name="rtuIp2" serializeAs="String">
        <value>192.168.1.103</value>
      </setting>
      <setting name="rtuIp3" serializeAs="String">
        <value>192.168.1.103</value>
      </setting>
      <setting name="pcsId1" serializeAs="String">
        <value>1</value>
      </setting>
      <setting name="pcsId2" serializeAs="String">
        <value>1</value>
      </setting>
      <setting name="pcsId3" serializeAs="String">
        <value>2</value>
      </setting>
      <setting name="pcsOut1" serializeAs="String">
        <value>1</value>
      </setting>
      <setting name="pcsOut2" serializeAs="String">
        <value>1</value>
      </setting>
      <setting name="pcsOut3" serializeAs="String">
        <value>1</value>
      </setting>
      <setting name="pcsPeriod1" serializeAs="String">
        <value>30</value>
      </setting>
      <setting name="pcsPeriod2" serializeAs="String">
        <value>30</value>
      </setting>
      <setting name="pcsPeriod3" serializeAs="String">
        <value>30</value>
      </setting>
    </EssPcsServer.Properties.Settings>
  </userSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
  <system.serviceModel>
    <services>
      <service behaviorConfiguration="" name="EssPcsService.EssPcsWcfService">
        <endpoint address="net.tcp://localhost:59008/wcf/esspcsservice" binding="netTcpBinding" bindingConfiguration="netTcpBindingConf" name="netTcpBindingConf" contract="EssPcsService.IEssPcsService" />
      </service>
    </services>
    <bindings>
      <netTcpBinding>
        <binding name="netTcpBindingConf">
          <security mode="None">
            <!--
          <security mode="Transport">
            <transport clientCredentialType="Windows"/>
            -->
          </security>
        </binding>
      </netTcpBinding>
    </bindings>
    <client />
  </system.serviceModel>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
      <provider invariantName="System.Data.SQLite.EF6" type="System.Data.SQLite.EF6.SQLiteProviderServices, System.Data.SQLite.EF6" />
    </providers>
  </entityFramework>
  <system.data>
    <DbProviderFactories>
      <remove invariant="System.Data.SQLite.EF6" />
      <add name="SQLite Data Provider (Entity Framework 6)" invariant="System.Data.SQLite.EF6" description=".NET Framework Data Provider for SQLite (Entity Framework 6)" type="System.Data.SQLite.EF6.SQLiteProviderFactory, System.Data.SQLite.EF6" />
      <remove invariant="System.Data.SQLite" />
      <add name="SQLite Data Provider" invariant="System.Data.SQLite" description=".NET Framework Data Provider for SQLite" type="System.Data.SQLite.SQLiteFactory, System.Data.SQLite" />
    </DbProviderFactories>
  </system.data>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="C1.Win.4.8" publicKeyToken="944ae1ea0e47ca04" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.8.20232.620" newVersion="4.8.20232.620" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="C1.Zip" publicKeyToken="79882d576c6336da" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.20202.1" newVersion="2.0.20202.1" />
      </dependentAssembly>
    </assemblyBinding>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>