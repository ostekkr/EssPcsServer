<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <system.serviceModel>
        <services>
            <service behaviorConfiguration="gpamvcbServiceBehavior" name="GpamVcbService.GpamVcbWcfService">
                <endpoint address="gpamvcbservice" binding="netTcpBinding" bindingConfiguration="netTcpBindingConf"
                    contract="GpamVcbService.IGpamVcbService" />
                <host>
                    <baseAddresses>
                        <add baseAddress="net.tcp://localhost:1002/wcf" />
                    </baseAddresses>
                </host>
            </service>
        </services>

        <bindings>
            <netTcpBinding>
                <binding name="netTcpBindingConf">
                    <security mode="Message">
                        <message clientCredentialType="UserName"/>
                    </security>
                </binding>
            </netTcpBinding>
        </bindings>

      <behaviors>
          <serviceBehaviors>
              <behavior name="gpamvcbServiceBehavior">
                  <serviceMetadata httpGetEnabled="true"/>
                  <serviceDebug includeExceptionDetailInFaults="true"/>
                  <serviceCredentials>
                  <userNameAuthentication userNamePasswordValidationMode="Custom"
                                          customUserNamePasswordValidatorType="GpamVcbService.DatabaseBasedValidator, GpamVcbService"/>
                  
                  <serviceCertificate findValue="myserver"
                                      x509FindType="FindBySubjectName"
                                      storeLocation="LocalMachine"
                                      storeName="My"/>
                    
                  </serviceCredentials>
              </behavior>
          </serviceBehaviors>
        </behaviors>
    </system.serviceModel>
</configuration>