<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <appSettings>
        <add key="C1ApplicationTheme" value="VS2013Light"/>
    </appSettings>
    <system.serviceModel>
        <services>
            <service behaviorConfiguration="esspcsServiceBehavior" name="EssPcsService.EssPcsWcfService">
                <endpoint address="esspcsservice" binding="netTcpBinding" bindingConfiguration="netTcpBindingConf" contract="EssPcsService.IEssPcsService"/>
                <host>
                    <baseAddresses>
                        <add baseAddress="net.tcp://localhost:59008/wcf"/>
                    </baseAddresses>
                </host>
            </service>
        </services>

        <bindings>
            <netTcpBinding>
                <binding name="netTcpBindingConf">
                    <security mode="Message">
                        <message clientCredentialType="UserName"/>
                    </security>
                </binding>
            </netTcpBinding>
        </bindings>

      <behaviors>
          <serviceBehaviors>
              <behavior name="esspcsServiceBehavior">
                  <serviceMetadata httpGetEnabled="true"/>
                  <serviceDebug includeExceptionDetailInFaults="true"/>
                  <serviceCredentials>
                  <userNameAuthentication userNamePasswordValidationMode="Custom" customUserNamePasswordValidatorType="EssPcsService.DatabaseBasedValidator, EssPcsService"/>
                  
                  <serviceCertificate findValue="myserver" x509FindType="FindBySubjectName" storeLocation="LocalMachine" storeName="My"/>
                    
                  </serviceCredentials>
              </behavior>
          </serviceBehaviors>
        </behaviors>
    </system.serviceModel>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup></configuration>
